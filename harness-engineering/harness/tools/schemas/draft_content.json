{
  "name": "draft_content",
  "description": "채널 규격에 맞는 콘텐츠 초안을 생성해 저장하고 content_id를 반환한다. 외부에 공개되지 않는다. 발행은 publish_post의 역할이며, 이 툴은 발행하지 않는다.",
  "input_schema": {
    "type": "object",
    "properties": {
      "channel": {"type": "string", "enum": ["blog", "instagram", "linkedin", "newsletter"]},
      "body": {"type": "string", "maxLength": 4000},
      "title": {"type": "string", "maxLength": 120}
    },
    "required": ["channel", "body"]
  },
  "x-side-effects": "reversible"
}
