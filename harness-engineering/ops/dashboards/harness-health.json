{
  "title": "ATLAS 하네스 상태",
  "note": "상단 4개는 docs/00-overview.md의 성공 기준과 1:1 대응. 아래는 진단용.",
  "rows": [
    {
      "title": "성공 기준",
      "panels": [
        {"metric": "atlas.golden_pass_rate", "target": 0.90, "alert_below": 0.85},
        {"metric": "atlas.rework_rate", "target": 0.15, "alert_above": 0.30},
        {"metric": "atlas.cost_per_run_usd", "target": 0.60, "alert_above": 1.20},
        {"metric": "atlas.latency_p95_seconds", "target": 40, "alert_above": 90}
      ]
    },
    {
      "title": "진단",
      "panels": [
        {"metric": "atlas.loop_iterations", "viz": "histogram", "note": "평균 상승은 비용 급증의 선행 신호"},
        {"metric": "atlas.guardrail_blocks", "group_by": "policy_id"},
        {"metric": "atlas.tool_denials", "group_by": "tool_name"},
        {"metric": "atlas.empty_retrieval", "alert_above": 0.05}
      ]
    }
  ]
}
