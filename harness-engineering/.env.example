# 복사해서 .env로 사용. .env는 절대 커밋하지 않는다.

# --- 모델 프로바이더 ---
ANTHROPIC_API_KEY=
ATLAS_DEFAULT_MODEL=claude-sonnet-5
ATLAS_JUDGE_MODEL=claude-opus-5

# --- 실행 환경 ---
ATLAS_ENV=dev                  # dev | stage | prod
ATLAS_LOG_LEVEL=INFO

# --- 하네스 예산 (초과 시 중단) ---
ATLAS_MAX_CONTEXT_TOKENS=120000
ATLAS_MAX_LOOP_ITERATIONS=6
ATLAS_MAX_COST_USD_PER_RUN=2.00

# --- 관측 ---
ATLAS_TRACE_DIR=./data/processed/traces
ATLAS_TRACE_SAMPLE_RATE=1.0    # prod에서는 0.1 권장
